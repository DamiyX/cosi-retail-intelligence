# Local Metro defaults to development when this is absent.
EXPO_PUBLIC_APP_ENV=development
# EAS sets development/preview explicitly in eas.json.
# production is reserved; M0 contains no production build profile.
# Optional, non-secret EAS identifiers once an account/project has been selected:
# EAS_OWNER=
# EAS_PROJECT_ID=
# No backend credentials are needed by M0.
# Future public backend config: EXPO_PUBLIC_SUPABASE_URL and
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY. Never use a service-role/secret key.
