# Local Metro defaults to development when this is absent.
EXPO_PUBLIC_APP_ENV=development
# EAS sets development/preview explicitly in eas.json.
# production is reserved; M0 contains no production build profile.
# Optional, non-secret EAS identifiers once an account/project has been selected:
# EAS_OWNER=
# EAS_PROJECT_ID=
# M7 pilot cloud sync. Public project URL and publishable key only.
# Offline local business flows continue when these are absent.
# Set these for the same development Supabase project on each laptop/build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never use a service-role/secret key in the mobile app.
